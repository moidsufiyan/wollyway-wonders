# WollyWay — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is listed in .gitignore.
#
# For production (Vercel), set these in the Vercel dashboard under
# Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Local development: http://localhost:5000/api/v1
# Production:        https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Application display name (used in metadata and email templates)
NEXT_PUBLIC_APP_NAME=WollyWay

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY RULES:
#
# ✓ NEXT_PUBLIC_ variables are embedded in the browser bundle — safe for URLs
# ✗ NEVER put secrets, API keys, or passwords in NEXT_PUBLIC_ variables
# ✗ NEVER commit .env.local to Git
# ✓ Use Vercel environment variables for production secrets
# ─────────────────────────────────────────────────────────────────────────────
